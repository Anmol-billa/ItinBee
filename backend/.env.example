# Server & Runtime
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://itinbee.com
JWT_SECRET=dev-itinbee-hmac-secret-change-in-production-32chars

# Public URLs & Render Host Wiring
APP_PUBLIC_URL=http://localhost:3000
FRONTEND_HOST=
PUBLIC_BACKEND_URL=
PUBLIC_BACKEND_HOST=

# Persistence & Queue (Leave blank in local dev to use pre-seeded LocalDevStore + inline memory queue)
# In NODE_ENV=production, DATABASE_URL is strictly required (fail-fast with startup backoff retry).
DATABASE_URL=
REDIS_URL=
RUN_INLINE_WORKER=true
LOCAL_DEV_STORE_FILE=

# DPDPA 2023 Encrypted Ticket Vault (Cloudflare R2 / AWS S3 + PostgreSQL vault_blobs fallback)
# Leave AWS_S3_VAULT_BUCKET blank to store AES-256-GCM encrypted envelopes in PostgreSQL `vault_blobs`.
# For Cloudflare R2, set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com and AWS_REGION=auto
S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_S3_VAULT_REGION=ap-south-1
AWS_S3_VAULT_BUCKET=
KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEV_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Stage 3 Structured LLM Fallback (GCP Vertex AI asia-south1 Mumbai, Zero Data Retention)
GCP_VERTEX_LOCATION=asia-south1
GCP_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_API_KEY=

# Security, Webhooks & Error Telemetry
TURNSTILE_SECRET_KEY=
WEBHOOK_HMAC_SECRET=
SENTRY_DSN=

# Open-Data Geospatial & Places Engine (Zero Google Places API calls)
PHOTON_BASE_URL=
ORS_API_KEY=
WIKIMEDIA_USER_AGENT=Itinbee/1.0 (contact via itinbee.com)
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
ADMIN_TOKEN=
PLACES_STORE_FILE=
PACK_TTL_DAYS=45

# Auth: Google Sign-In & Email Magic Link / Co-Editor Invites (Resend API or SMTP via Nodemailer)
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Itinbee <onboarding@resend.dev>"
# Optional SMTP alternative (works with Gmail App Passwords, Brevo, Postmark, SES without custom domain)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Phase 3 (AI curation & Smart Import grounded in open place data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
IMPORT_DAILY_LIMIT_GUEST=15
IMPORT_DAILY_LIMIT_USER=50
IMPORT_DAILY_LIMIT_IP=60
IMPORT_DAILY_GLOBAL_CAP=500
IMPORT_DAILY_LIMIT_ASSIST=60
IMPORT_PACK_WAIT_MS=15000
