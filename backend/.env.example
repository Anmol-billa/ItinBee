# Server & Runtime
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://itinbee.com
JWT_SECRET=dev-itinbee-hmac-secret-change-in-production-32chars

# Persistence & Queue (Leave blank in local dev to use pre-seeded LocalDevStore + inline memory queue)
# Render singapore production sets both automatically via render.yaml
DATABASE_URL=
REDIS_URL=
RUN_INLINE_WORKER=true
LOCAL_DEV_STORE_FILE=

# DPDPA 2023 Mumbai PII Vault (AWS ap-south-1)
AWS_S3_VAULT_REGION=ap-south-1
AWS_S3_VAULT_BUCKET=itinbee-vault-ap-south-1
KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEV_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Stage 3 Structured LLM Fallback (GCP Vertex AI asia-south1 Mumbai, Zero Data Retention)
GCP_VERTEX_LOCATION=asia-south1
GCP_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_API_KEY=

# Zero-OTP Guest Polls (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=

# Open-Data Geospatial Search (Self-hosted Photon / Overture endpoint; zero Google Places API calls)
PHOTON_BASE_URL=

# Open-data places engine (destinations, Destination Packs, routing). No Google Places data is ever used.
# OpenRouteService key (free at https://openrouteservice.org/dev/#/signup). Without it routing degrades to the India transit estimator.
ORS_API_KEY=
# Identify the app to Wikimedia/Overpass/Photon (their usage policies require a descriptive User-Agent with contact info)
WIKIMEDIA_USER_AGENT=Itinbee/1.0 (contact via itinbee.com)
# Comma-separated Overpass mirrors used for failover (the background pack job is the only caller)
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Protects POST /v1/destinations/:slug/pack. Required in production; optional (open) in development/test.
ADMIN_TOKEN=
# Optional JSON file persistence for the in-memory places store used when DATABASE_URL is unset
PLACES_STORE_FILE=
# Packs older than this are served but refreshed in the background
PACK_TTL_DAYS=45
# Auth: Google Sign-In & Email Magic Link (Resend). In dev without keys, devMagicCode / devEmail sign-in is enabled.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Itinbee <login@itinbee.com>"
APP_PUBLIC_URL=http://localhost:3000

# Phase 3 (AI curation & Smart Import grounded in open place data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 3 Smart Import. Without GEMINI_API_KEY (or when quota is exhausted) imports run in deterministic "Basic mode".
GEMINI_TIMEOUT_MS=45000
# Daily (UTC) quotas. Per guest user / per signed-in user / per client IP / global AI-build cap (beyond the cap jobs run in Basic mode)
IMPORT_DAILY_LIMIT_GUEST=15
IMPORT_DAILY_LIMIT_USER=50
IMPORT_DAILY_LIMIT_IP=60
IMPORT_DAILY_GLOBAL_CAP=500
# "Ask Itinbee" assist calls per user per day
IMPORT_DAILY_LIMIT_ASSIST=60
# How long the planner waits for a destination pack to build before using what is already stored (ms)
IMPORT_PACK_WAIT_MS=15000
