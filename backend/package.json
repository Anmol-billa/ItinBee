{
  "name": "itinbee-backend",
  "version": "1.0.0",
  "description": "Itinbee standalone Fastify 5 API, HLC delta-sync engine, Indian ticket parser pipeline, PostGIS/local store, and UPI expense ledger",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/modules/places/seed && cp src/modules/places/seed/destinations.json dist/modules/places/seed/",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-entry.js",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts",
    "migrate:deploy": "tsx src/scripts/migrate.ts",
    "seed:destinations": "tsx src/scripts/seed-destinations.ts",
    "pack:build": "tsx src/scripts/pack-build.ts",
    "eval:import": "tsx src/scripts/eval-import.ts",
    "test": "vitest run",
    "test:parsers": "vitest run test/parsers.test.ts",
    "test:sync": "vitest run test/sync.test.ts",
    "test:security": "vitest run test/security.test.ts",
    "test:ledger": "vitest run test/ledger-polls-geo.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/websocket": "^11.0.1",
    "bullmq": "^5.40.0",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.3",
    "unpdf": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
