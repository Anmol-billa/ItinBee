{
  "name": "itinbee-frontend",
  "version": "1.0.0",
  "description": "Itinbee standalone Next.js App Router SSR, offline IndexedDB PWA, and minimalist collaborative trip workbench",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "sync:api-types": "openapi-typescript ../backend/openapi.json -o src/lib/api-schema.d.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:bundle-budget": "vitest run test/bundle-and-upi.test.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.1.0",
    "next": "^15.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
